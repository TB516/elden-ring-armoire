{
  "name": "Elden Ring Armoire",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "remoteUser": "node",
  "shutdownAction": "stopCompose",
  "forwardPorts": [5173],
  "postCreateCommand": "test -f .env || cp .env.example .env; pnpm install --frozen-lockfile",
  "customizations": {
    "vscode": {
      "extensions": ["svelte.svelte-vscode", "oxc.oxc-vscode"]
    }
  }
}
