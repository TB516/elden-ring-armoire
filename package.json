{
  "name": "elden-ring-armoire",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "start": "node --env-file-if-exists=.env build"
  },
  "dependencies": {},
  "devDependencies": {
    "@sveltejs/adapter-node": "6.0.0-next.10",
    "@sveltejs/kit": "3.0.0-next.25",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "^24.13.3",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "^6.0.0",
    "vite": "8.2.2"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "pnpm@11.23.0"
}
