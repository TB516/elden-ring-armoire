# Copy to .env and fill in the values. Never commit .env.
# The devcontainer supplies database and object-storage settings.
BETTER_AUTH_URL=http://localhost:5173
# Generate with: node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64"))'
BETTER_AUTH_SECRET=
# Register http://localhost:5173/api/auth/callback/discord in the Discord developer portal.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
